# Laravel backend. Defaults to http://winly-backend.test when unset.
#
# `.test` is resolved by the Mac's local DNS (Herd/Valet). The iOS simulator
# inherits that, but a physical device and the Android emulator do not — point
# this at the machine's LAN address there, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=https://winly.on-forge.com/
