{
  "expo": {
    "name": "Welle",
    "slug": "winly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/generated/welle-icon-1024.png",
    "scheme": "winly",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#073729",
        "foregroundImage": "./assets/images/brand/generated/welle-adaptive-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.neilpatrick.winly",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E7D56",
          "image": "./assets/images/brand/welle_logo.png",
          "imageWidth": 132
        }
      ],
      "expo-secure-store",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2E7D56",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Welle needs access to your photos so you can attach one to a movement or learning entry."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9e4b54ec-c469-4137-b87e-6c36002cd89e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9e4b54ec-c469-4137-b87e-6c36002cd89e"
    }
  }
}
